{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "attendease-cbc6f",
          "appId": "1:645842511929:android:a79bc7d4c4db80afa045e8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "attendease-cbc6f",
          "configurations": {
            "android": "1:645842511929:android:a79bc7d4c4db80afa045e8",
            "ios": "1:645842511929:ios:60676ef619243669a045e8",
            "macos": "1:645842511929:ios:60676ef619243669a045e8",
            "web": "1:645842511929:web:209a1f48b66e8ed2a045e8",
            "windows": "1:645842511929:web:88efa48e8b400d60a045e8"
