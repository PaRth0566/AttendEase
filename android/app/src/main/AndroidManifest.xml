<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RECEIVE_BOOT_COMPLETED, POST_NOTIFICATIONS, SCHEDULE_EXACT_ALARM,
         USE_EXACT_ALARM and USE_FULL_SCREEN_INTENT used to be declared here.
         They belonged to flutter_local_notifications, which was dropped from
         pubspec.yaml in 908fd15 along with the notifications feature; the
         permissions and the plugin's boot receiver were left behind.

         Nothing declares or needs them now — no plugin, no Dart, no Kotlin —
         and none of them arrive from a dependency manifest, so removing them
         genuinely removes them from what Play shows users rather than being
         re-merged. USE_EXACT_ALARM and USE_FULL_SCREEN_INTENT are also
         Play-policy-restricted, and an attendance tracker has no alarm or
         calling feature to justify either.

         Anything scheduled in future needs the matching permission back. -->

    <!-- Advertising ID. No AttendEase code reads it. It arrives with
         firebase-analytics (play-services-measurement -> play-services-ads-identifier),
         whose library manifest declares the permission, and the manifest merger
         folds it into the release build whether or not it is written here.

         Declared explicitly so it is visible on inspection and matches the
         "Yes" on Play Console's Advertising ID declaration (App content ->
         Advertising ID, purpose: Analytics). Play blocks Android 13+ releases
         that answer "Yes" without this permission present.

         Deleting the firebase-analytics dependency in app/build.gradle.kts is
         the only way to drop this — see the note there for what else changes. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <application
        android:label="AttendEase"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />

            <!-- Keep an incoming PDF's URI out of Flutter's routing.

                 With deep linking on, the Flutter embedding takes the launch
                 intent's data URI and hands it to Dart as the *initial route*.
                 go_router then tried to navigate to
                 "content://com.whatsapp.provider.media/item/..." — no such
                 route — and rendered its Page Not Found screen instead of the
                 app, so the PDF handler never got a chance to run.

                 A tapped PDF is not a navigation request; it is a file delivered
                 to MainActivity, which reads it over the incoming_pdf channel.
                 Turning this off restores the normal launch route and is what
                 makes the feature work at all. The app declares no http/https
                 App Links, so nothing else depends on it. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- "Open with" for attendance PDFs. Declared on MainActivity rather
                 than a second activity because launchMode is singleTop: a tap
                 while the app is already running arrives at onNewIntent instead
                 of building a fresh task. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:mimeType="application/pdf"/>
                <data android:scheme="file" android:mimeType="application/pdf"/>
            </intent-filter>

            <!-- The file managers that hand a PDF over under a generic or
                 plainly wrong MIME type. Without this AttendEase is missing from
                 the chooser on those devices, which is most of the point of the
                 feature, so the filename is trusted instead of the type.
                 A non-PDF that merely ends in .pdf reaches the parser and fails
                 there with the normal error, which is the safe direction.

                 host="*" is required for pathPattern to be meaningful, and rules
                 out file:// URIs (which carry no host) — those are covered by
                 the correctly-typed filter above, and Android has blocked them
                 between apps since N anyway. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:host="*"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="binary/octet-stream"/>
                <data android:mimeType="*/*"/>
                <data android:pathPattern=".*\\.pdf"/>
                <data android:pathPattern=".*\\.PDF"/>
            </intent-filter>

            <!-- And the ones that send no type at all. A filter declaring any
                 mimeType is skipped outright for a typeless intent, so those
                 need a filter that declares none. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:pathPattern=".*\\.pdf"/>
                <data android:pathPattern=".*\\.PDF"/>
            </intent-filter>

            <!-- Share sheet: Gmail attachments and Chrome downloads offer Share
                 rather than Open with. SEND_MULTIPLE takes the first PDF. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- The Play Store, so PlayReviewLauncher can see it.
             Android 11+ filters package visibility: an intent pinned with
             setPackage("com.android.vending") resolves to null from an app that
             has not declared it, no matter that Play is installed. Without
             these two entries the "Rate AttendEase" review deep link would
             silently report "no Play app" on every modern device and fall
             through to the browser. -->
        <package android:name="com.android.vending"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
    </queries>
</manifest>
